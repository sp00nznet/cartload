// Version resource. Beyond being the right thing for a shipped binary, a statically
// linked exe with no version info at all is a large input to Defender's ML heuristics --
// the unsigned single-exe build was flagged Trojan:Win32/Bearfoos.A!ml without this.
#include <winver.h>

// Generated from this file by CMake: the version lives in project() and nowhere else.
VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0" // US English, Unicode
    BEGIN
      VALUE "CompanyName", "sp00nz"
      VALUE "FileDescription", "Cartload - multi-system libretro frontend for handhelds"
      VALUE "FileVersion", "@PROJECT_VERSION@.0"
      VALUE "InternalName", "cartload"
      VALUE "LegalCopyright", "MIT licensed"
      VALUE "OriginalFilename", "cartload.exe"
      VALUE "ProductName", "Cartload"
      VALUE "ProductVersion", "@PROJECT_VERSION@.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
