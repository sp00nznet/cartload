// Version resource. Beyond being the right thing for a shipped binary, a statically
// linked exe with no version info at all is a large input to Defender's ML heuristics --
// the unsigned single-exe build was flagged Trojan:Win32/Bearfoos.A!ml without this.
#include <winver.h>

#define CARTLOAD_VERSION 0, 1, 0, 0
#define CARTLOAD_VERSION_STR "0.1.0.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CARTLOAD_VERSION
PRODUCTVERSION CARTLOAD_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0" // US English, Unicode
    BEGIN
      VALUE "CompanyName", "sp00nz"
      VALUE "FileDescription", "Cartload - multi-system libretro frontend for handhelds"
      VALUE "FileVersion", CARTLOAD_VERSION_STR
      VALUE "InternalName", "cartload"
      VALUE "LegalCopyright", "MIT licensed"
      VALUE "OriginalFilename", "cartload.exe"
      VALUE "ProductName", "Cartload"
      VALUE "ProductVersion", CARTLOAD_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
